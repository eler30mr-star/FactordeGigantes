{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "factor-de-gigantes",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "factor-de-gigantes-db",
      "database_id": "ef699e75-b50a-4e28-a665-69316d10cdaf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPO": "eler30mr-star/FactordeGigantes",
    "GITHUB_WORKFLOW": "render.yml",
    "CLOUDFLARE_AI_FREE_CONFIRMED": "0",
    "FINAL_AI_INTEGRATION_ENABLED": "0"
  }
}
